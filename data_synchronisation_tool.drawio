          </mxGeometry>
        </mxCell>
        <mxCell id="phr_yK9-dTZH4B_XSwU8-22" parent="1" style="rounded=1;whiteSpace=wrap;html=1;" value="&lt;div&gt;Acknowledgement of update:&amp;nbsp;&lt;/div&gt;&lt;div&gt;Update our known state of the remote when full transfers are confirmed&lt;/div&gt;" vertex="1">
